---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Timeline from '../components/Timeline.astro';
import Impact from '../components/Impact.astro';
import Projects from '../components/Projects.astro';
import TechStack from '../components/TechStack.astro';
import Contact from '../components/Contact.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { useTranslations } from '../i18n/utils';
const lang = 'en';
const t = useTranslations(lang);
---
<Layout title={t('meta.title')} description={t('meta.description')} lang={lang}>
  <Nav lang={lang} t={t} portfolio={true} />
  <main id="main" class="portfolio-page">
    <Hero lang={lang} t={t} />
    <Timeline lang={lang} t={t} />
    <Impact lang={lang} t={t} />
    <Projects lang={lang} t={t} />
    <TechStack lang={lang} t={t} />
    <Contact lang={lang} t={t} />
  </main>
  <SiteFooter lang={lang} />
</Layout>
