---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Timeline from '../../components/Timeline.astro';
import Impact from '../../components/Impact.astro';
import Projects from '../../components/Projects.astro';
import TechStack from '../../components/TechStack.astro';
import Contact from '../../components/Contact.astro';
import { LANGS, DEFAULT_LANG, useTranslations } from '../../i18n/utils';

// One page, one route per locale. The default locale is served at the site
// root, which a rest parameter expresses as an empty segment (`undefined`);
// every other locale gets its code as a prefix. The language is passed down as
// a prop rather than parsed back out of the URL, so it can never be guessed
// wrong.
export function getStaticPaths() {
  return LANGS.map((lang) => ({
    params: { lang: lang === DEFAULT_LANG ? undefined : lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Layout
  title={t('meta.title')}
  description={t('meta.description')}
  lang={lang}
>
  <Nav lang={lang} t={t} />
  <main id="main">
    <Hero lang={lang} t={t} />
    <Timeline lang={lang} t={t} />
    <Impact lang={lang} t={t} />
    <Projects lang={lang} t={t} />
    <TechStack lang={lang} t={t} />
    <Contact lang={lang} t={t} />
  </main>
</Layout>
