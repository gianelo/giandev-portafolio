---
import Layout from '../../layouts/Layout.astro';
import Home from '../../components/home/Home.astro';
import '../../styles/home.css';
import { homeEn, homeEs } from '../../i18n/home';
import { LANGS, DEFAULT_LANG } from '../../i18n/utils';

// One page, one route per locale. The default locale is served at the site
// root, which a rest parameter expresses as an empty segment (`undefined`);
// every other locale gets its code as a prefix. The language is passed down as
// a prop rather than parsed back out of the URL, so it can never be guessed
// wrong.
export function getStaticPaths() {
  return LANGS.map((lang) => ({
    params: { lang: lang === DEFAULT_LANG ? undefined : lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
const c = lang === 'es' ? homeEs : homeEn;
---

<Layout
  title={c.title}
  description={c.description}
  lang={lang}
  services={true}
>
  <Home lang={lang} />
</Layout>
