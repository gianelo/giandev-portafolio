---
import SectionHeading from './SectionHeading.astro';

export interface Props {
  lang: string;
  t: (key: string) => string;
}

const { lang, t } = Astro.props;

interface Stat {
  key: 'years' | 'uptime' | 'volume' | 'payments';
  value: number;
  decimals?: number;
  prefix?: string;
  suffix?: string;
}

const stats: Stat[] = [
  { key: 'years',    value: 10,   suffix: '+' },
  { key: 'uptime',   value: 99.9, decimals: 1, suffix: '%' },
  { key: 'volume',   value: 200,  prefix: '$', suffix: 'K+' },
  { key: 'payments', value: 5,    suffix: '+' },
];
---

<section class="section" id="impact">
  <div class="site-wrap">
  <SectionHeading
    label={t('term.section.02.label')}
    title={t('term.section.02.title')}
    sub={t('term.section.02.sub')}
  />

  <div class="stats-grid">
    {stats.map((s) => (
      <div class="stat">
        <div class="stat-value">
          <span
            class="stat-num"
            data-counter={s.value}
            data-decimals={s.decimals ?? 0}
            data-prefix={s.prefix ?? ''}
            data-locale={lang}
          >{(s.prefix ?? '') + (s.decimals ? s.value.toFixed(s.decimals).replace('.', lang === 'es' ? ',' : '.') : s.value)}</span><span class="unit">{s.key === 'uptime' && lang === 'es' ? ' %' : s.suffix ?? ''}</span>
        </div>
        <div class="stat-label">{t(`impact.${s.key}.label`)}</div>
      </div>
    ))}
  </div>
  </div>
</section>

<script is:inline>
  (function () {
    function format(value, decimals, prefix, locale) {
      const n = decimals > 0 ? value.toFixed(decimals).replace('.', locale === 'es' ? ',' : '.') : Math.round(value).toString();
      return (prefix || '') + n;
    }

    const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
    const active = new Map();
    motionPreference.addEventListener('change', () => {
      if (motionPreference.matches) {
        active.forEach((finish) => finish());
      }
    });

    function animate(el) {
      const target = parseFloat(el.dataset.counter);
      const decimals = parseInt(el.dataset.decimals || '0', 10);
      const prefix = el.dataset.prefix || '';
      const locale = el.dataset.locale;
      if (Number.isNaN(target)) return;

      // Respeta prefers-reduced-motion: muestra valor final sin animación
      if (motionPreference.matches) {
        el.textContent = format(target, decimals, prefix, locale);
        return;
      }

      const duration = 1400;
      const start = performance.now();
      let frame;
      function finish() {
        cancelAnimationFrame(frame);
        el.textContent = format(target, decimals, prefix, locale);
        active.delete(el);
      }
      active.set(el, finish);
      function tick(now) {
        if (motionPreference.matches) {
          finish();
          return;
        }
        const p = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = format(target * eased, decimals, prefix, locale);
        if (p < 1) frame = requestAnimationFrame(tick);
        else finish();
      }
      frame = requestAnimationFrame(tick);
    }

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          animate(e.target);
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.4 });

    function init() {
      document.querySelectorAll('.stat-num[data-counter]').forEach((el) => io.observe(el));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
