---
import SectionHeading from './SectionHeading.astro';

export interface Props {
  lang: string;
  t: (key: string) => string;
}

const { t } = Astro.props;

type CaseKey = 'infra' | 'seo' | 'fraud' | 'payments' | 'rentoru';

// Order is deliberate: the first card renders expanded. The newest independent
// product, Rentoru, leads; the existing cases retain their relative order.
const cases: { key: CaseKey; tags: string[] }[] = [
  {
    key: 'rentoru',
    tags: ['TypeScript', 'Next.js', 'PostgreSQL', 'Drizzle ORM', 'Cloudflare R2', 'Vitest', 'Playwright'],
  },
  {
    key: 'payments',
    tags: ['Stripe', 'PayPal', 'DLocal', 'Shift4', 'Payeezy', 'Payment Routing', '3DS', 'Apple Pay', 'Google Pay', 'Tokenization'],
  },
  {
    key: 'fraud',
    tags: ['Factory Pattern', 'SRP', 'Device Fingerprinting', 'Rules Engine', 'n8n'],
  },
  {
    key: 'infra',
    tags: ['MySQL Replication', 'HAProxy', 'DigitalOcean', 'Nginx', 'Linux'],
  },
  {
    key: 'seo',
    tags: ['ChatGPT-4o', 'Node.js', 'Programmatic SEO', 'AI', 'PHP'],
  },
];
---

<section class="section wrap" id="cases">
  <SectionHeading
    label={t('term.section.03.label')}
    title={t('term.section.03.title')}
    sub={t('term.section.03.sub')}
  />

  <div class="case-list reveal">
    {cases.map((c, i) => (
      <article class={`case ${i === 0 ? 'open' : ''}`} data-case={c.key}>
        <h3>
          <button
            type="button"
            class="case-head"
            id={`case-trigger-${c.key}`}
            aria-controls={`case-panel-${c.key}`}
            aria-expanded={i === 0 ? 'true' : 'false'}
          >
            <span class="case-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="case-heading">
              <span class="case-title">{t(`projects.${c.key}.title`)}</span>
              <span class="case-metric">{t(`term.case.${c.key}.metric`)}</span>
            </span>
            <span class="case-toggle" aria-hidden="true">{i === 0 ? '−' : '+'}</span>
          </button>
        </h3>
        <div
          class="case-body"
          id={`case-panel-${c.key}`}
          role="region"
          aria-labelledby={`case-trigger-${c.key}`}
          hidden={i !== 0}
        >
          <div class="case-body-inner">
            <div class="case-grid">
              <div class="label">{t('term.case.label.context')}</div>
              <div class="text">{t(`projects.${c.key}.context`)}</div>

              <div class="label">{t('term.case.label.problem')}</div>
              <div class="text">{t(`projects.${c.key}.problem`)}</div>

              <div class="label">{t('term.case.label.decision')}</div>
              {/* Rendered as HTML so a dense architecture write-up can break into
                  paragraphs. Cases without markup render exactly as before. */}
              <div class="text" set:html={t(`projects.${c.key}.decision`)} />

              <div class="label">{t('term.case.label.result')}</div>
              <div class="text">
                <div class="case-result">
                  <span class="num">{t(`term.case.${c.key}.result.num`)}</span>
                  <span>{t(`term.case.${c.key}.result.text`)}</span>
                  {c.key === 'rentoru' && (
                    <div>
                      <a class="btn" href={t('projects.rentoru.url')}>{t('projects.rentoru.link')}</a>
                    </div>
                  )}
                </div>
                <div class="tag-row">
                  {c.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll('.case').forEach((card) => {
      const head = card.querySelector('.case-head');
      if (!head) return;
      head.addEventListener('click', () => {
        const isOpen = card.classList.contains('open');
        // Close all
        document.querySelectorAll('.case.open').forEach((other) => {
          other.classList.remove('open');
          const btn = other.querySelector('.case-head');
          if (btn) btn.setAttribute('aria-expanded', 'false');
          const panel = other.querySelector('.case-body');
          if (panel) panel.hidden = true;
          const toggle = other.querySelector('.case-toggle');
          if (toggle) toggle.textContent = '+';
        });
        // Open this one if it wasn't already
        if (!isOpen) {
          card.classList.add('open');
          head.setAttribute('aria-expanded', 'true');
          const panel = card.querySelector('.case-body');
          if (panel) panel.hidden = false;
          const toggle = card.querySelector('.case-toggle');
          if (toggle) toggle.textContent = '−';
        }
      });
    });
  })();
</script>
