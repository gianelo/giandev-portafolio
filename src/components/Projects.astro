---
import SectionHeading from './SectionHeading.astro';

export interface Props {
  lang: string;
  t: (key: string) => string;
}

const { t } = Astro.props;

type CaseKey = 'infra' | 'seo' | 'fraud' | 'payments' | 'rentoru';

// Order is deliberate: the first card renders expanded. The newest independent
// product, Rentoru, leads; the existing cases retain their relative order.
const cases: { key: CaseKey; tags: string[] }[] = [
  {
    key: 'rentoru',
    tags: ['TypeScript', 'Next.js', 'PostgreSQL', 'Drizzle ORM', 'Cloudflare R2', 'Vitest', 'Playwright'],
  },
  {
    key: 'payments',
    tags: ['Stripe', 'PayPal', 'DLocal', 'Shift4', 'Payeezy', 'Payment Routing', '3DS', 'Apple Pay', 'Google Pay', 'Tokenization'],
  },
  {
    key: 'fraud',
    tags: ['Factory Pattern', 'SRP', 'Device Fingerprinting', 'Rules Engine'],
  },
  {
    key: 'infra',
    tags: ['MySQL Replication', 'HAProxy', 'DigitalOcean', 'Nginx', 'Linux'],
  },
  {
    key: 'seo',
    tags: ['ChatGPT-4o', 'Node.js', 'Programmatic SEO', 'AI', 'PHP'],
  },
];
---

<section class="section" id="cases">
  <div class="site-wrap">
  <SectionHeading
    label={t('term.section.03.label')}
    title={t('term.section.03.title')}
    sub={t('term.section.03.sub')}
  />

  <div class="case-list">
    {cases.map((c, i) => (
      <details class="portfolio-case" id={`case-${c.key}`} open={i === 0}>
          <summary>
            <span class="case-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="case-name">
              <strong>{t(`projects.${c.key}.title`)}</strong>
              <span>{t(`term.case.${c.key}.metric`)}</span>
            </span>
            <span class="case-sign" aria-hidden="true"></span>
          </summary>
        <div class="case-content">
            <dl>
              <dt>{t('term.case.label.context')}</dt>
              <dd>{t(`projects.${c.key}.context`)}</dd>

              <dt>{t('term.case.label.problem')}</dt>
              <dd>{t(`projects.${c.key}.problem`)}</dd>

              <dt>{t('term.case.label.decision')}</dt>
              {/* Rendered as HTML so a dense architecture write-up can break into
                  paragraphs. Cases without markup render exactly as before. */}
              <dd set:html={t(`projects.${c.key}.decision`)} />

              <dt>{t('term.case.label.result')}</dt>
              <dd>{t(`projects.${c.key}.outcome`)}</dd>
            </dl>
            <div class="case-tags">
              {c.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            {c.key === 'rentoru' && (
              <div><a class="btn" href={t('projects.rentoru.url')}>{t('projects.rentoru.link')} ↗</a></div>
            )}
            <button class="case-close" type="button" data-close-case>{t('portfolio.case.close')}</button>
        </div>
      </details>
    ))}
  </div>
  </div>
</section>

<script is:inline data-case-disclosures>
  (function () {
    let navigation = 0;
    // Native summary activation owns open/closed state, including without JS.
    document.querySelectorAll('[data-close-case]').forEach((button) => {
      button.addEventListener('click', () => {
        const details = button.closest('details');
        navigation++;
        details.open = false;
        details.querySelector('summary').focus();
      });
    });

    function openHashCase() {
      const current = ++navigation;
      let id;
      try { id = decodeURIComponent(window.location.hash.slice(1)); }
      catch (_) { return; }
      const details = document.getElementById(id);
      if (!details || !details.matches('details.portfolio-case')) return;
      details.open = true;
      details.scrollIntoView({ block: 'start' });
      // Initial native fragment landing can override inline-script focus. Wait
      // for load and two paint frames; never reclaim a closed or stale target.
      function focusAfterLanding() {
        window.requestAnimationFrame(() => window.requestAnimationFrame(() => {
          if (current !== navigation || !details.open) return;
          details.querySelector('summary').focus({ preventScroll: true });
        }));
      }
      if (document.readyState === 'complete') focusAfterLanding();
      else window.addEventListener('load', focusAfterLanding, { once: true });
    }
    openHashCase();
    window.addEventListener('hashchange', openHashCase);
  })();
</script>
