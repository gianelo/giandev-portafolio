---
import BrandMark from './BrandMark.astro';
import { getPortfolioHref, getServicesHref, shellCopy, type Lang } from '../i18n/utils';
interface Props {
  lang: Lang;
  description?: string;
  copyright?: string;
  credit?: string;
}
const { lang, description, copyright, credit = 'gianbarboza.com' } = Astro.props;
const c = shellCopy[lang];
---
<footer class="site-footer">
  <div class="site-wrap">
    <div class="site-footer-main">
      <div>
        <a class="site-mark" href={getPortfolioHref(lang)}><BrandMark /><span>gian.barboza</span></a>
        <p class="site-footer-desc">{description ?? c.description}</p>
      </div>
      <nav class="site-footer-links" aria-label={c.footer}>
        <a href={getServicesHref(lang)}>{c.services}</a>
        <a href={getPortfolioHref(lang)}>{c.portfolio}</a>
        <slot name="links">
          <a href="https://linkedin.com/in/gian-barboza">LinkedIn ↗</a>
          <a href="https://github.com/gianelo">GitHub ↗</a>
        </slot>
      </nav>
    </div>
    <div class="site-footer-bottom">
      <span>{copyright ?? `© ${new Date().getFullYear()} Gian Barboza`}</span>
      <span>{credit}</span>
    </div>
  </div>
</footer>
