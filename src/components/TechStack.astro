---
import SectionHeading from './SectionHeading.astro';

export interface Props {
  lang: string;
  t: (key: string) => string;
}

const { t } = Astro.props;

const categories = [
  {
    key: 'backend',
    glyph: '/srv',
    tags: ['Node.js', 'Express', 'TypeScript', 'Next.js', 'PHP', 'Laravel', 'Redis', 'Java', 'REST APIs'],
  },
  {
    key: 'architecture',
    glyph: '/arch',
    tags: ['Distributed Systems', 'High Availability', 'Clean Architecture', 'Design Patterns', 'Gateway Pattern', 'API Design'],
  },
  {
    key: 'infra',
    glyph: '/infra',
    tags: ['Linux', 'HAProxy', 'Nginx', 'MySQL Replication', 'PostgreSQL', 'DigitalOcean', 'Docker', 'GitHub Actions', 'Cronjobs'],
  },
  {
    key: 'payments',
    glyph: '/pay',
    tags: ['Stripe', 'PayPal', 'DLocal', 'Shift4', 'Payeezy', 'Payment Routing', 'Fraud Engines', 'Device Fingerprinting', 'PCI Compliance'],
  },
  {
    key: 'ai',
    glyph: '/ai',
    tags: ['LLM Integration', t('stack.ai.assisted'), 'Programmatic SEO', 'Content Automation', 'Web Scraping'],
  },
];
---

<section class="section" id="stack">
  <div class="site-wrap">
  <SectionHeading
    label={t('term.section.04.label')}
    title={t('term.section.04.title')}
    sub={t('term.section.04.sub')}
  />

  <div class="exp-grid">
    {categories.map((cat, i) => (
      <div class={`exp-card reveal reveal-delay-${Math.min(i + 1, 4)}`}>
        <div class="exp-head">
          <h3 class="exp-name">{t(`stack.${cat.key}.title`)}</h3>
        </div>
        <div class="exp-tags">
          {cat.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>
    ))}
  </div>
  </div>
</section>
