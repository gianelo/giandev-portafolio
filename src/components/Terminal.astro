---
export interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;

// Positioning (see AGENTS.md → Posicionamiento de Marca): the role line reads
// "Senior Backend Engineer & Software Architect" everywhere, visible copy included.
// The `$ commands` are not translated — they are shell, not copy.
// Domain slugs stay untranslated for the same reason the `$ commands` do: they
// read as directory names, not copy. Each one maps to real work on this page —
// four of them are the case studies below.
const domains = [
  'payments',
  'distributed-systems',
  'infrastructure',
  'fraud-detection',
  'automation',
];

/** A rendered terminal row. Blank rows carry no class; `suf` is the unstyled
 *  tail after a coloured marker, so both are optional. */
interface Line {
  t: string;
  cls?: string;
  suf?: string;
}

const tree: Line[] = domains.map((d, i) => ({
  t: `${i === domains.length - 1 ? '└──' : '├──'} ${d}`,
  cls: 'val',
}));

const lines: Line[] = [
  { t: '$ whoami', cls: 'prompt' },
  { t: t('term.terminal.role'), cls: 'key' },
  { t: t('term.terminal.building'), cls: 'val' },
  { t: '' },
  { t: '$ tree architecture/', cls: 'prompt' },
  { t: 'architecture/', cls: 'key' },
  ...tree,
  { t: '' },
  { t: '$ engineering_principles', cls: 'prompt' },
  { t: '✓', cls: 'ok', suf: ` ${t('term.terminal.p1')}` },
  { t: '✓', cls: 'ok', suf: ` ${t('term.terminal.p2')}` },
  { t: '✓', cls: 'ok', suf: ` ${t('term.terminal.p3')}` },
  { t: '✓', cls: 'ok', suf: ` ${t('term.terminal.p4')}` },
  { t: '' },
  { t: '$ status', cls: 'prompt' },
  { t: `✓ ${t('term.terminal.status')}`, cls: 'ok' },
];
---

<div class="terminal" aria-hidden="true">
  <div class="terminal-bar">
    <div class="lights"><span></span><span></span><span></span></div>
    <span style="margin-left: 8px">~/portfolio — zsh</span>
  </div>
  <div class="terminal-body">
    {lines.map((l) => (
      <div>
        {l.t === '' ? <>&nbsp;</> : (
          <>
            <span class={l.cls}>{l.t}</span>
            {l.suf && <span class="val">{l.suf}</span>}
          </>
        )}
      </div>
    ))}
    <div>
      <span class="prompt">$ </span>
      <span class="cursor"></span>
    </div>
  </div>
</div>
