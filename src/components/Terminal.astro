---
// Capa marketing (ver AGENTS.md → Posicionamiento de Marca): acá va
// "Software Engineer", no "Backend Engineer".
// El ancho útil a ≥1100px es ~66 caracteres — mantener las líneas por debajo.
const lines = [
  { t: '$ whoami', cls: 'prompt' },
  { t: 'gian.barboza · Senior Software Engineer', cls: 'key' },
  { t: 'Building payments, distributed systems & AI-assisted software.', cls: 'val' },
  { t: '' },
  { t: '$ engineering_principles', cls: 'prompt' },
  { t: '✓', cls: 'ok', suf: ' Production first' },
  { t: '✓', cls: 'ok', suf: ' Measure before optimizing' },
  { t: '✓', cls: 'ok', suf: ' Evolution over rewrites' },
  { t: '✓', cls: 'ok', suf: ' Architecture over frameworks' },
  { t: '' },
  { t: '$ status', cls: 'prompt' },
  { t: '✓ Available for full-time remote', cls: 'ok' },
];
---

<div class="terminal" aria-hidden="true">
  <div class="terminal-bar">
    <div class="lights"><span></span><span></span><span></span></div>
    <span style="margin-left: 8px">~/portfolio — zsh</span>
  </div>
  <div class="terminal-body">
    {lines.map((l) => (
      <div>
        {l.t === '' ? <>&nbsp;</> : (
          <>
            <span class={l.cls}>{l.t}</span>
            {l.suf && <span class="val">{l.suf}</span>}
          </>
        )}
      </div>
    ))}
    <div>
      <span class="prompt">$ </span>
      <span class="cursor"></span>
    </div>
  </div>
</div>
