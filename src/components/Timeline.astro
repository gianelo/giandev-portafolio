---
import SectionHeading from './SectionHeading.astro';
export interface Props {
  lang: string;
  t: (key: string) => string;
}
const { t } = Astro.props;
const milestones = ['now', 'freelance', 'cto', 'fermat'];
---
<section class="section" id="journey">
  <div class="site-wrap">
    <SectionHeading label={t('term.section.01.label')} title={t('term.section.01.title')} sub={t('term.section.01.sub')} />
    <div class="journey-list">
      {milestones.map(key => (
        <article class="journey-item">
          <div class="journey-period">
            <span class="journey-date">{t(`timeline.${key}.period`)}</span>
          </div>
          <div>
            <h3 class="journey-role">{t(`timeline.${key}.role`)}</h3>
            <p class="journey-company">{t(`timeline.${key}.company`)}</p>
            <p class="journey-desc">{t(`timeline.${key}.desc`)}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
