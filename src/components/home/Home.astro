---
import { homeEn, homeEs } from '../../i18n/home';
import Inquiry from './Inquiry.astro';
import Nav from '../Nav.astro';
import SiteFooter from '../SiteFooter.astro';
import { getPortfolioHref, useTranslations, type Lang } from '../../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const c = lang === 'es' ? homeEs : homeEn;
const portfolio = getPortfolioHref(lang);
const caseIds = ['infra', 'payments', 'fraud'];

---
<Nav lang={lang} t={useTranslations(lang)} />
<main id="main" class="home-page">
  <div class="home-wrap home-hero">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>{c.eyebrow}</p>
    <div class="hero-layout">
      <div>
        <h1>{c.hero.map((line, i) => <span class:list={['hero-line', { amber: i === 2 }]}>{line}</span>)}</h1>
        <p class="hero-lead">{c.lead}</p>
        <div class="home-actions">
          <a class="home-button site-button primary" href="#contact">{c.primary}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
          <a class="home-button site-button secondary" href={portfolio}>{c.portfolio}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
        </div>
        <p class="hero-note">{c.heroNote}</p>
      </div>
      <div class="signature">
        <span aria-hidden="true">↳</span>
        <div><strong>Gian Barboza</strong><small>{c.role}</small></div>
      </div>
    </div>
    <div class="expertise">{c.strip.map(item => <span>{item}</span>)}</div>
  </div>
  <section id="services" class="home-section">
    <div class="home-wrap">
      <p class="section-label">{c.serviceLabel}</p>
      <div class="section-heading"><h2>{c.serviceTitle.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2><p>{c.serviceIntro}</p></div>
      <div class="problems">
        {c.problems.map(problem => <article><h3>{problem[0]}</h3><p>{problem[1]}</p></article>)}
      </div>
      <div class="services">
        {c.services.map((service, i) => <article class="service">
          <div class="service-top">
            <span class="meta">0{i + 1} / {lang === 'es' ? 'INGENIERÍA' : 'ENGINEERING'}</span>
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              {i === 0 ? <path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-12-2 24" /> : <><rect x="3" y="5" width="26" height="22" rx="3" /><path d="M3 12h26m-20 9h6" /></>}
            </svg>
          </div>
          <h3>{service[0]}</h3>
          <p class="promise">{service[1]}</p>
          <p class="scope">{service[2]}</p>
          <p class="deliverables">{service[3]}</p>
        </article>)}
      </div>
      <p class="scope-note">{c.scopeNote}</p>
    </div>
  </section>
  <section id="work" class="home-section">
    <div class="home-wrap">
      <p class="section-label">{c.workLabel}</p>
      <div class="section-heading"><h2>{c.workTitle.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2><p>{c.workIntro}</p></div>
      <div class="work-grid">
        {c.cases.map((item, i) => <article class="case">
          <p class="meta">0{i + 1} / {item[0]}</p>
          <h3>{item[1].split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h3>
          <dl>{c.caseLabels.map((label, j) => <><dt>{label}</dt><dd>{item[j + 2]}</dd></>)}</dl>
          <div class="metric"><strong>{item[5]}</strong><small>{item[6]}</small></div>
          <a class="text-link" href={`${portfolio}#case-${caseIds[i]}`}>{c.caseLink}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg><span class="sr-only">: {item[1].replace('\n', ' ')}</span></a>
        </article>)}
      </div>
    </div>
  </section>
  <section id="process" class="home-section">
    <div class="home-wrap">
      <p class="section-label">{c.processLabel}</p>
      <div class="section-heading"><h2>{c.processTitle.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2><p>{c.processIntro}</p></div>
      <div class="steps">
        {c.steps.map((step, i) => <article>
          <span class="step-number">0{i + 1}</span>
          <h3>{step[0]}</h3>
          <p>{step[1]}</p>
        </article>)}
      </div>
    </div>
  </section>
  <Inquiry lang={lang} c={c} />
  <div class="home-wrap closing">
    <div><h2>{c.closing.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)}</h2><p>{c.closingText}</p></div>
    <a class="home-button site-button secondary" href="#contact">{c.primary}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
  </div>
</main>
<SiteFooter lang={lang} description={c.footer} />
