---
const { c } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() || '';
const required = ['name', 'email', 'today', 'help'];
const keys = ['name', 'email', 'company', 'today', 'help'];
---
<section id="contact" class="home-section home-contact">
  <div class="home-wrap contact-grid">
    <div>
      <p class="section-label">{c.contactLabel}</p>
      <h2>{c.contactTitle.split('\n').map((line: string, i: number) => <>{i > 0 && <br />}{line}</>)}</h2>
      <p>{c.contactIntro}</p>
      <p class="contact-small">{c.contactSmall}</p>
    </div>
    <div>
      <p class="required-note">{c.required}</p>
      <form id="inquiry" method="post" action="/api/inquiry" novalidate aria-label={c.submit}>
        <div id="inquiry-errors" class="error-summary" tabindex="-1" role="alert" hidden></div>
        <div class="form-grid">
          {keys.map(key =>
            <div class:list={['field', { wide: !['name', 'email'].includes(key) }]}>
              <label for={key}>
                {c.labels[key]} {required.includes(key) ? '*' : <span class="optional">({c.optional})</span>}
              </label>
              {c.hints[key] && <span class="helper" id={`${key}-hint`}>{c.hints[key]}</span>}
              {['today', 'help'].includes(key)
                ? <textarea id={key} name={key} rows="4" maxlength="5000" placeholder={c.placeholders[key]} required aria-describedby={`${key}-error ${key}-hint`}></textarea>
                : <input
                    id={key}
                    name={key}
                    type={key === 'email' ? 'email' : 'text'}
                    maxlength="200"
                    placeholder={c.placeholders[key]}
                    required={required.includes(key)}
                    autocomplete={key === 'name' ? 'name' : key === 'email' ? 'email' : key === 'company' ? 'organization' : 'off'}
                    aria-describedby={`${key}-error`}
                  />}
              <span id={`${key}-error`} class="field-error" hidden></span>
            </div>
          )}
        </div>
        <details>
          <summary>{c.details}</summary>
          <div class="form-grid">
            {['budget', 'timeline'].map(key =>
              <div class="field">
                <label for={key}>{c.labels[key]} <span class="optional">({c.optional})</span></label>
                <input id={key} name={key} type="text" maxlength="200" autocomplete="off" placeholder={c.placeholders[key]} aria-describedby={`${key}-error`} />
                <span id={`${key}-error`} class="field-error" hidden></span>
              </div>
            )}
          </div>
        </details>
        <div class="hp-field" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="inquiry-verification">
          <div id="inquiry-turnstile" data-sitekey={turnstileSiteKey} data-action="inquiry" data-language={c.verificationLanguage}></div>
          <p id="turnstile-status" class="helper" role="status" tabindex="-1">{c.verificationLoading}</p>
          <button id="retry-turnstile" class="home-button site-button secondary" type="button" hidden>{c.verificationRetry}</button>
        </div>
        <p class="privacy">{c.privacy}</p>
        <button class="home-button site-button primary submit" type="submit"><span>{c.submit}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></button>
        <p id="inquiry-progress" class="progress" role="status" hidden></p>
        <div id="inquiry-status" class="feedback" role="status" tabindex="-1" hidden>
          <h3>{c.successTitle}</h3><p></p>
          <button class="home-button site-button secondary" id="retry-notification" type="button" hidden>{c.retryEmail}</button>
          <button class="home-button site-button secondary" id="edit-inquiry" type="button">{c.again}</button>
        </div>
        <noscript><p>{c.noscript} <a href="https://linkedin.com/in/gian-barboza">LinkedIn</a></p></noscript>
      </form>
    </div>
  </div>
</section>
<script is:inline define:vars={{ messages: {
  required: c.requiredError,
  email: c.emailError,
  invalid: c.invalid,
  loading: c.loading,
  success: c.success,
  successTitle: c.successTitle,
  savedTitle: c.savedTitle,
  emailPending: c.emailPending,
  retryUnknown: c.retryUnknown,
  failure: c.failure,
  sending: c.sending,
  verificationLoading: c.verificationLoading,
  verificationRequired: c.verificationRequired,
  verificationUnavailable: c.verificationUnavailable,
  verificationExpired: c.verificationExpired,
  verificationReady: c.verificationReady
} }}>
  const form = document.getElementById('inquiry');
  const summary = document.getElementById('inquiry-errors');
  const status = document.getElementById('inquiry-status');
  const progress = document.getElementById('inquiry-progress');
  const submit = form.querySelector('[type=submit]');
  const submitLabel = submit.querySelector('span');
  const idleLabel = submitLabel.textContent;
  const fields = [...form.querySelectorAll('.field input,.field textarea')];
  const retryNotification = document.getElementById('retry-notification');
  const editInquiry = document.getElementById('edit-inquiry');
  let retryToken = '';
  const startedAt = Date.now();
  let busy = false;
  const widget = document.getElementById('inquiry-turnstile');
  const verificationStatus = document.getElementById('turnstile-status');
  const retryVerification = document.getElementById('retry-turnstile');
  const siteKey = widget.dataset.sitekey;
  let token = '';
  let widgetId;
  let verificationUnavailable = false;
  let scriptAttempt = 0;

  function verificationFailure() {
    token = '';
    verificationUnavailable = true;
    verificationStatus.textContent = messages.verificationUnavailable;
    retryVerification.hidden = !siteKey;
  }

  function resetVerification(message) {
    token = '';
    verificationStatus.textContent = message;
    try {
      window.turnstile.reset(widgetId);
    } catch {
      verificationFailure();
    }
  }

  function renderVerification() {
    if (widgetId !== undefined) return;
    try {
      widgetId = window.turnstile.render(widget, {
        sitekey: siteKey,
        action: 'inquiry',
        language: widget.dataset.language,
        size: 'flexible',
        'response-field': false,
        callback: value => {
          token = typeof value === 'string' ? value.trim() : '';
          verificationUnavailable = false;
          retryVerification.hidden = true;
          verificationStatus.textContent = token ? messages.verificationReady : messages.verificationRequired;
        },
        'expired-callback': () => resetVerification(messages.verificationExpired),
        'timeout-callback': () => resetVerification(messages.verificationExpired),
        'error-callback': () => { verificationFailure(); return true; }
      });
    } catch {
      verificationFailure();
    }
  }

  function loadVerification() {
    if (!siteKey) { verificationFailure(); return; }
    verificationUnavailable = false;
    retryVerification.hidden = true;
    verificationStatus.textContent = messages.verificationLoading;
    if (window.turnstile) { renderVerification(); return; }
    const attempt = ++scriptAttempt;
    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    script.async = true;
    // A blocked script must leave a recoverable state, not an endless spinner.
    const timer = setTimeout(() => {
      if (attempt === scriptAttempt && widgetId === undefined) verificationFailure();
    }, 15000);
    script.addEventListener('load', () => {
      clearTimeout(timer);
      if (attempt === scriptAttempt) renderVerification();
    });
    script.addEventListener('error', () => {
      clearTimeout(timer);
      if (attempt === scriptAttempt) verificationFailure();
    });
    document.head.append(script);
  }

  retryVerification.addEventListener('click', () => {
    if (busy) return;
    if (widgetId !== undefined) {
      verificationUnavailable = false;
      retryVerification.hidden = true;
      resetVerification(messages.verificationRequired);
    } else loadVerification();
    verificationStatus.focus();
  });
  loadVerification();

  function validate(field) {
    let error = '';
    if (field.required && !field.value.trim()) error = messages.required;
    else if (field.type === 'email' && field.value && !field.validity.valid) error = messages.email;

    const span = document.getElementById(field.id + '-error');
    span.textContent = error;
    span.hidden = !error;
    field.setAttribute('aria-invalid', String(Boolean(error)));
    return !error;
  }

  fields.forEach(field => field.addEventListener('blur', () => validate(field)));

  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (busy) return;
    status.hidden = true;
    progress.hidden = true;

    const invalid = fields.filter(field => !validate(field));
    summary.replaceChildren();
    if (invalid.length) {
      const p = document.createElement('p');
      p.textContent = messages.invalid;
      const list = document.createElement('ul');
      invalid.forEach(field => {
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = '#' + field.id;
        link.textContent = form.querySelector(`label[for="${field.id}"]`).textContent;
        link.addEventListener('click', e => {
          e.preventDefault();
          field.focus();
        });
        li.append(link);
        list.append(li);
      });
      summary.append(p, list);
      summary.hidden = false;
      summary.focus();
      return;
    }

    summary.hidden = true;
    if (!token || verificationUnavailable) {
      verificationStatus.textContent = verificationUnavailable ? messages.verificationUnavailable : messages.verificationRequired;
      verificationStatus.focus();
      return;
    }
    const data = Object.fromEntries(new FormData(form));
    if (data.website || Date.now() - startedAt < 2000) {
      summary.textContent = messages.failure;
      summary.hidden = false;
      summary.focus();
      return;
    }
    data.startedAt = startedAt;
    data.turnstileToken = token;
    if (retryToken) data.retryToken = retryToken;
    // Tokens are single-use even when the API response is lost or rejected.
    token = '';
    busy = true;
    submit.disabled = true;
    // The retry reference is signed over this exact snapshot. Do not let a
    // visitor edit fields while a saved-but-email-pending response is in flight.
    fields.forEach(field => { field.readOnly = true; });
    submitLabel.textContent = messages.sending;
    form.setAttribute('aria-busy', 'true');
    progress.textContent = messages.loading;
    progress.hidden = false;

    try {
      const response = await fetch('/api/inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await response.json();
      if (!response.ok || result.success !== true) throw new Error('Not accepted');
      if (result.email === 'pending') {
        retryToken = typeof result.retryToken === 'string' ? result.retryToken : '';
        status.dataset.state = 'pending';
        status.querySelector('h3').textContent = messages.savedTitle;
        status.querySelector('h3').hidden = false;
        status.querySelector('p').textContent = messages.emailPending;
        retryNotification.hidden = !retryToken;
        editInquiry.hidden = true;
        fields.forEach(field => { field.readOnly = !!retryToken; });
      } else if (result.email === 'accepted') {
        retryToken = '';
        fields.forEach(field => { field.readOnly = false; });
        retryNotification.hidden = true;
        editInquiry.hidden = false;
        status.dataset.state = 'success';
        status.querySelector('h3').textContent = messages.successTitle;
        status.querySelector('h3').hidden = false;
        status.querySelector('p').textContent = messages.success;
      } else throw new Error('Unknown delivery state');
      status.hidden = false;
      status.focus();
    } catch {
      status.dataset.state = retryToken ? 'pending' : 'failure';
      status.querySelector('h3').hidden = !retryToken;
      if (retryToken) status.querySelector('h3').textContent = messages.savedTitle;
      status.querySelector('p').textContent = retryToken ? messages.retryUnknown : messages.failure;
      retryNotification.hidden = !retryToken;
      editInquiry.hidden = !!retryToken;
      status.hidden = false;
      status.focus();
    } finally {
      resetVerification(messages.verificationRequired);
      busy = false;
      submit.disabled = false;
      if (!retryToken) fields.forEach(field => { field.readOnly = false; });
      submitLabel.textContent = idleLabel;
      progress.hidden = true;
      form.removeAttribute('aria-busy');
    }
  });

  retryNotification.addEventListener('click', () => {
    if (!busy) form.requestSubmit();
  });
  editInquiry.addEventListener('click', () => {
    status.hidden = true;
    fields[0].focus();
  });
</script>
