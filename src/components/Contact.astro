---
import { getLocaleHref, type Lang } from '../i18n/utils';
export interface Props {
  lang: Lang;
  t: (key: string) => string;
}
const { lang, t } = Astro.props;
---
<section class="section" id="contact">
  <div class="site-wrap p-contact">
    <div>
      <p class="section-label">{t('term.cta.eyebrow')}</p>
      <h2 set:html={t('term.cta.title.html')} />
      <p>{t('term.cta.sub')}</p>
      <a class="btn" href={`${getLocaleHref(lang)}#contact`}>
        {t('term.cta.contact')}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </a>
    </div>
    <div class="p-contact-links">
      <a href={`mailto:${t('contact.email')}`}>{t('contact.email')}</a>
      <a href={t('contact.phone.url')}>{t('contact.phone')}</a>
      <a href={t('contact.linkedin.url')}>LinkedIn ↗</a>
      <a href={t('contact.github.url')}>GitHub ↗</a>
      <a href={t('contact.english.url')}>{t('contact.english')} ↗</a>
    </div>
  </div>
</section>
