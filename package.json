{
  "name": "giandev-portafolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run src",
    "test:build": "astro build && vitest run tests/build-output.test.ts",
    "test:all": "npm run typecheck && npm run test && npm run test:build",
    "cv": "npx --yes md-to-pdf CV.md && mv CV.pdf public/gian-barboza-cv.pdf && npx --yes md-to-pdf CV-es.md && mv CV-es.pdf public/gian-barboza-cv-es.pdf",
    "test:live": "vitest run tests/live-redirects.test.ts",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^6.2.1",
    "satori": "^0.19.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
