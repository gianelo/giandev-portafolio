{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run typecheck && npm run test && npm run test:build",
  "headers": [
    {
      "source": "/gian-barboza-cv.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"gian-barboza-cv.pdf\""
        }
      ]
    },
    {
      "source": "/gian-barboza-cv-es.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"gian-barboza-cv-es.pdf\""
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/en/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/en",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/en/:path*",
      "destination": "/",
      "statusCode": 301
    }
  ]
}
